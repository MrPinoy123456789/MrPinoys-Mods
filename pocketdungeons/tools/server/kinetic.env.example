# Copy to kinetic.env (gitignored) to point pdserver.mjs and the Lemon MCP server at a
# Kinetic Hosting test server instead of the local one. Delete kinetic.env, or set
# PD_TARGET=local, to go back to the local server.

KINETIC_PANEL_URL="https://kineticpanel.net"

# The short id in the panel URL: kineticpanel.net/server/<id>?workspace=...
KINETIC_SERVER_ID="714a0605"

# A *client* API key from the panel: Account > API Credentials. Use a key made for
# Lemon alone (limited to your home IP if the panel allows it), so it can be revoked
# without touching the Discord bot's key.
KINETIC_API_KEY=""
