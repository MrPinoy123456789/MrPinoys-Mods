{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundry/item.v1",
  "title": "Foundry item definition, version 1",
  "description": "Mirrors foundry.core.ItemDef. The Java parser is authoritative until a schema generated from it replaces this file; ItemSchemaTest (planned, task T2) must keep the two in step.",
  "type": "object",
  "required": ["schema_version", "id", "display_name", "base_item"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
    "display_name": { "type": "string", "minLength": 1 },
    "lore": { "type": "array", "items": { "type": "string" } },
    "base_item": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
    "model": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
    "texture": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$", "description": "Flat item texture; Foundry generates the model. Exclusive with model." },
    "mechanics": { "type": "array", "maxItems": 8, "description": "See docs/MECHANICS.md. Each: trigger, optional conditions, actions, cooldown_ticks, chance.", "items": { "type": "object", "required": ["trigger", "actions"], "properties": { "trigger": { "enum": ["on_use", "on_hit_entity"] }, "cooldown_ticks": { "type": "integer", "minimum": 0 }, "chance": { "type": "number", "minimum": 0, "maximum": 1 }, "conditions": { "type": "array", "maxItems": 8, "items": { "type": "object", "required": ["type"] } }, "actions": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "object", "required": ["type"] } } } } },
    "stack_size": { "type": "integer", "minimum": 1, "maximum": 99, "default": 64 },
    "durability": { "type": "integer", "minimum": 0, "default": 0 },
    "glint": { "type": "boolean", "default": false },
    "rarity": { "enum": ["common", "uncommon", "rare", "epic"], "default": "common" }
  }
}
