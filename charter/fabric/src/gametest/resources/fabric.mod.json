      "charter.gametest.LandProtectionGameTest",
      "charter.gametest.LandHazardsGameTest",
      "charter.gametest.GranaryGameTest"
    ]
  },
  "mixins": [
    "charter-gametest.mixins.json"
  ],
  "depends": {
    "charter": "*"
  }
}
